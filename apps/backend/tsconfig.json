{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
      "src/**/*.ts", 
      "src/generated/prisma"
  ],
  "exclude": [
    "node_modules", 
    "seed.ts", 
    "dist"
  ]
}