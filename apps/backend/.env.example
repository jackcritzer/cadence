# These values are not read from .env at runtime.
# Instead, they are loaded from AWS SSM using getSSMParameter().
# This file is just a reference for developers.

# Server
PORT=3001

# JWT
JWT_SECRET=change_this_in_ssm

# CORS
CORS_ORIGIN=https://app.cadencestudio.com

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cadence

# AWS S3 (used for uploads)
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key